# ─────────────────────────────────────────
# Idswyft Community Edition Configuration
# ─────────────────────────────────────────
# Copy to .env and fill in values:
#   cp .env.community .env
#
# Or run the install script to auto-generate secrets:
#   ./install.sh
# ─────────────────────────────────────────

# Database password (use a strong random value)
DB_PASSWORD=

# Authentication secrets (generate with: openssl rand -hex 16)
JWT_SECRET=
API_KEY_SECRET=
ENCRYPTION_KEY=
SERVICE_TOKEN=

# Port to expose the frontend (default: 80)
# In HTTPS mode, set to 127.0.0.1:8080 so only Caddy serves external traffic
IDSWYFT_PORT=80

# Set to true to enable sandbox/mock verification mode
SANDBOX_MODE=false

# ─── Email delivery (optional) ─────────────────
# Developer OTP codes and credential emails. Pick ONE transport:
# SMTP (any mail server) — implied when SMTP_HOST is set:
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURE=false                 # true = implicit TLS (port 465)
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# EMAIL_FROM=noreply@yourdomain.com
# or Resend (managed email API):
# RESEND_API_KEY=re_your_key_here
# EMAIL_FROM=noreply@yourdomain.com
# Without either, login codes are printed to the API container logs
# (docker compose logs api | grep -i OTP).

# ─── Developer portal SSO via OpenID Connect (optional) ──────
# Lets developers sign in with your identity provider instead of email OTP.
# Works with Keycloak, Authentik, Auth0, Okta, Azure AD, Dex, …
# OIDC_ISSUER_URL=https://sso.yourdomain.com/realms/yourrealm   # no trailing slash
# OIDC_CLIENT_ID=idswyft-developer-portal
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost/   # your frontend origin (the page that receives ?code&state)
# OIDC_SCOPES=openid email profile

# ─── HTTPS / TLS (optional) ──────────────────
# Set ENABLE_HTTPS=true and configure DOMAIN to enable Caddy HTTPS proxy.
# Run ./install.sh for interactive setup, or configure manually:
#   1. Copy caddy/Caddyfile.acme (or .manual) to caddy/Caddyfile
#   2. Set the values below
#   3. Run: docker compose --profile https up -d
ENABLE_HTTPS=false
DOMAIN=
CORS_ORIGINS=
